{
  "name": "@dsh-external/dsh-anatomy",
  "version": "0.20.4",
  "description": "自由工程画板：二维编辑与 GPU 三维空间共用数据、程序映射和项目版本。",
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "examples",
    "docs",
    "scripts/*.mjs",
    "scripts/*.py",
    "scripts/requirements-ocr.txt",
    ".codex-plugin",
    ".mcp.json",
    "native/app.py",
    "native/anatomy3d.py",
    "native/run.sh",
    "native/README.md",
    "native/selftest.py"
  ],
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent-skill",
    "anatomy",
    "human-ai-co-reading",
    "natural-language-structure"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-tools": ">=0.1.5-rc.2 <0.2.0",
    "@deepseek-ai/dsh-skill": ">=0.1.5-rc.2 <0.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node test/e2e.mjs && node --test test/regressions.mjs test/co-reading.mjs test/semantics.mjs test/board.mjs test/preview.mjs test/reading.mjs test/versions.mjs test/layout.mjs test/mcp.mjs test/math-expressions.mjs test/canvas-edit.mjs test/paper-edit.mjs test/images.mjs test/mcp-images.mjs test/reading-canvas.mjs test/versions-ui-races.mjs test/drawing.mjs test/drawing-client.mjs test/math-client.mjs test/recognition.mjs test/recognition-agent.mjs test/recognition-setup.mjs test/recognition-client.mjs test/recognition-tool.mjs test/space.mjs test/space-input.mjs test/space-client.mjs test/space-paper.mjs && node test/render-smoke.mjs",
    "serve": "node scripts/setup-recognition.mjs serve",
    "recognition:check": "node scripts/setup-recognition.mjs check",
    "recognition:install": "node scripts/setup-recognition.mjs install",
    "recognition:update": "node scripts/setup-recognition.mjs update",
    "recognition:warmup": "node scripts/setup-recognition.mjs warmup",
    "test:ocr": "python3 -m unittest discover -s test -p test_handwriting.py",
    "mcp": "node scripts/mcp-server.mjs",
    "test:space:browser": "node test/space-renderer-browser.mjs && node test/space-browser.mjs",
    "build:space": "node scripts/build-space.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bba686593-cloud/dsh-anatomy.git"
  },
  "homepage": "https://github.com/bba686593-cloud/dsh-anatomy#readme",
  "bugs": {
    "url": "https://github.com/bba686593-cloud/dsh-anatomy/issues"
  }
}
